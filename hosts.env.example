# =====================================================================
# 集群配置清单 —— 复制为 hosts.env 并按实际环境填写
# hosts.env 已被 .gitignore 忽略，凭据/IP 不会入库；只在此文件里填真实值
# =====================================================================

# ---- 接入 ----
JUMP_HOST="${JUMP_HOST:-}"        # 跳板机 ssh 别名；内网直连则留空
JUMP_IP="${JUMP_IP:-}"            # 跳板机 IP（JUMP_HOST 非空时必填）
JUMP_USER="${JUMP_USER:-root}"
NODE_USER="${NODE_USER:-root}"

# ---- 机器清单（别名:内网IP），node0 必须是主节点（NODE_RANK=0）----
NODES=(
  "node0:192.168.0.10"
  "node1:192.168.0.11"
  "node2:192.168.0.12"
  "node3:192.168.0.13"
)

# ---- 容器与镜像 ----
CONTAINER_NAME="train-950dt"      # 各机使用同一容器名
IMAGE="registry.example.com/namespace/image:tag"
# 拉私有镜像需先 docker login；凭据手动执行，不要写进任何入库文件

# ---- 共享存储（SFS Turbo）----
SFS_MOUNT="/mnt/sfs_turbo"        # 各机保持一致的挂载点
SFS_EXPORT=""                     # 华为云 SFS Turbo 的 NFS 导出地址（mount_sfs.sh 用）
                                  # 形如 xxxx.sfsturbo.internal:/ ，控制台"挂载指令"里可复制

# ---- 训练（MindSpeed-MM 约定；其他框架改 launch_multinode.sh 即可）----
MM_DIR="/home/ma-user/mm-turbo/MindSpeed-MM"   # 容器内框架目录
RUN_SCRIPT="run_sft.sh"                        # MM_DIR 下的启动脚本（读取 VC_* 环境变量）
MASTER_PORT="${MASTER_PORT:-6000}"
NPUS_PER_NODE="${NPUS_PER_NODE:-8}"
EXTRA_ENV=""                      # 附加训练变量，如 "MBS=1 GAS=16 MAX_STEPS=300 SEQ_LEN=258k对应值"

# ---- 容器扩展（run_container.sh）----
EXTRA_MOUNTS=""                   # 额外 -v 挂载，如 "/aics_data/:/aics-data/"
EXTRA_DEVICES=""                  # 额外 --device
SOC_VERSION="${SOC_VERSION:-ascend950}"

# ---- setup_ssh.sh 专用：首次分发公钥的初始密码（仅内存中使用，用完即弃）----
INIT_PASSWORD=""
